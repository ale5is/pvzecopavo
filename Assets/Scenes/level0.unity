--- !u!102 &2352
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900}
  m_Text: "\u4E0B\u96E8\uFF1A\u5927\u96E8\u65F6\u5929\u7A7A\u4F1A\u66F4\u52A0\u9634\u6697\uFF0C\u5929\u7A7A\u4F1A\u505C\u6B62\u843D\u5149\uFF0C\u90E8\u5206\u5730\u56FE\u4F1A\u51FA\u73B0\u6C34\u5751\uFF0C\u6C34\u5751\u4F1A\u8BA9\u690D\u7269\n\u7F3A\u6C27\u53D7\u4F24\uFF0C\u8BF7\u7528\u83B2\u53F6\u548C\u82B1\u76C6\u5C06\u690D\u7269\u57AB\u9AD8\u3002\u4E0B\u96E8\u5C06\u4F1A\u964D\u4F4E\u5411\u65E5\u8475\u7B49\u690D\u7269\u4EA7\u91CF\u3002\n\u96F7\u96E8\uFF1A\u96F7\u96E8\u5929\u7684\u665A\u4E0A\u5C06\u4F1A\u770B\u4E0D\u5230\u4E00\u5207\uFF0C\u8BF7\u7528\u4F1A\u53D1\u5149\u7684\u690D\u7269\u7167\u660E\uFF0C\u690D\u7269\u548C\u50F5\u5C38\u90FD\u4F1A\u88AB\u96F7\u7535\n\u5288\u4E2D\n\u4E0B\u96EA\uFF1A\u4E0B\u96EA\u5929\u4F1A\u5728\u5730\u9762\u5F62\u6210\u79EF\u96EA\uFF0C\u79EF\u96EA\u4F1A\u628A\u690D\u7269\u51BB\u7ED3\uFF0C\u8BF7\u7528\u94F2\u5B50\u94F2\u96EA\u6216\u8005\u706B\u70AC\u6811\u6869\u878D\u96EA\n\uFF0C\u6C34\u9762\u4F1A\u53D8\u6210\u51B0\u9762\uFF0C\u8BF7\u7528\u82B1\u76C6\u5728\u51B0\u9762\u4E0A\u79CD\u690D\u690D\u7269\uFF0C\u79EF\u96EA\u4F1A\u4F7F\u8C4C\u8C46\u5C04\u624B\u7B49\u690D\u7269\u51B0\u5316\u5347\u7EA7"
