  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 278}
  m_Text: "\u690D\u7269\u7761\u89C9\u673A\u5236\uFF1A\u51E0\u4E4E\u6240\u6709\u7684\u690D\u7269\u90FD\u4F1A\u7761\u89C9\uFF0C\u767D\u5929\u690D\u7269\u5728\u665A\u4E0A\u6709\u6982\u7387\u7761\u89C9\uFF0C\u591C\u665A\u690D\u7269\u767D\u5929\n\u5FC5\u7761\u89C9\uFF0C\u5E26\u597D\u5496\u5561\u8C46\uFF0C\u4ED6\u53EA\u6D88\u801725\u9633\u5149\n\n\u7D2B\u5361\u79CD\u690D\u673A\u5236\uFF1A\u7D2B\u5361\u53EF\u4EE5\u4F7F\u7528\u5E95\u5EA7\u690D\u7269\uFF0C\u4E5F\u53EF\u4EE5\u4E0D\u4F7F\u7528\uFF0C\u5728\u4E0D\u4F7F\u7528\u65F6\u6D88\u8017\u5E95\u5EA7\u690D\u7269\u6240\u9700\n\u9633\u5149\u4EE5\u53CA\u989D\u591650\u9633\u5149\uFF0C\u9999\u84B2\u989D\u5916\u6D88\u8017\u66F4\u591A\uFF01\n\n\u591A\u5730\u56FE\u673A\u5236\uFF1A\u66F4\u591A\u9009\u62E9\u9009\u5173\u65F6\u5173\u5361\u4FE1\u606F\u663E\u793A\u5173\u5361\u5730\u56FE\uFF0C\u591A\u5F20\u5730\u56FE\u4F1A\u5E76\u884C\u51FA\u602A\uFF0C\n\u8BF7\u7528\u5DE6\u4E0A\u89D2\u7684\u5730\u56FE\u5207\u6362\u952E\u6765\u9632\u5FA1\u5168\u90E8\u50F5\u5C38\n\nPVP\u73A9\u6CD5\u4E2D\uFF0C\u7070\u70EC\u690D\u7269\u4F24\u5BB3\u5C06\u88AB\u8303\u56F4\u5185\u5168\u90E8\u50F5\u5C38\u5747\u5206\uFF0C\u4F18\u5148\u6253\u5012\u5BF9\u65B93\u4E2A\u6807\u9776\u5373\u4E3A\u83B7\u80DC"
