--- !u!102 &2371
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1316}
  m_Text: "\u624B\u673A\u7248\u70B9\u51FB\u53F3\u4E0A\u89D2\u804A\u5929\u5373\u53EF\u518D\u70B9\u51FB\u5373\u53EF\u53D1\u9001\uFF0C\u7535\u8111\u70B9\u51FB\u952E\u76D8\u4E0A\u7684T\u952E\u6253\u5F00\u8F93\u5165\u6846\r\n\u6307\u4EE4\u53EA\u6709\u623F\u4E3B\u53EF\u4EE5\u4F7F\u7528\r
    \u8BF7\u4F7F\u7528/open\u4EE5\u542F\u7528\u6307\u4EE4\n\u8E22\u4EBA:/kick +\u540D\u5B57
    \u79C1\u4FE1:/msg +\u540D\u5B57 (\u8FD9\u4E24\u9879\u65E0\u9700\u542F\u7528\u6307\u4EE4\u5373\u53EF\u4F7F\u7528)\r\n\u6539\u65F6\u95F4:/time
    set day(08:00) /time set night (19:00) /time set \u4EFB\u610F\u6570\u5B57\r\n\u6674\u5929:/weather
    clear \u5F00\u542F\u4E0B\u96E8:/weather rain \u5F00\u542F\u96F7\u96E8:/weather
    thunder\r\n\u6E05\u9664:/kill zombie there(zombie\u6E05\u9664\u50F5\u5C38\uFF0C\u6539\u4E3Aplant\u5219\u4E3A\u690D\u7269;\nthere\u4E3A\u5F53\u524D\u5730\u56FE\uFF0C\u6539\u4E3Aall\u5219\u662F\u6240\u6709\u5730\u56FE)\r\n\u4FEE\u6539\u9633\u5149:/sun
    add+\u4EFB\u610F\u6570\u5B57\u6216/sun set+\u4EFB\u610F\u6570\u5B57\u6216\u8005/sun
    infinite(add\u4E3A\u589E\u52A0,\ninfinite\u662F\u65E0\u9650)set\u662F\u6539\u4E3A\uFF0C\r/sun
    auto\u542F\u7528\u81EA\u52A8\u6536\u96C6\n/cd infinite\u4E3A\u65E0cd \u91CD\u5236\u51B7\u5374:/cd
    clear \n\u79CD\u690D\u690D\u7269:/fill +\u2460+\u2461+\u2462(\u2460\u4E3A\u690D\u7269\u9009\u5361\u754C\u9762\u7684\u987A\u5E8F;\u2461\u4E3A\u8D77\u59CB\u5750\u6807\u4F4D\u7F6E\u2462\u4E3A\u672A\u7AEF\u5750\u6807\u4F4D\u7F6E,\n\u6240\u6709\u5750\u6807\u6570\u5B57\u90FD\u8981\u7A7A\u683C)\r
    \u4FEE\u6539\u5361\u69FD:/card +\u2460 +\u9009\u5361\u65F6\u7684\u5E8F\u53F7
    \u8C4C\u8C461 \u5411\u65E5\u84752\r\n\u6E38\u620F\u4E0D\u5931\u8D25:/gamerule
    dontfail\u690D\u7269\u4E0D\u7761\u89C9:/gamerule plantdontsleep\n\u690D\u7269\u65E0\u654C:/gamerule
    plantinvincible\r\n\u50F5\u5C38\u65E0\u654C:/gamerule zombieinvincible\u65F6\u95F4\u4E0D\u6D41\u52A8\uFF1A/gamerule
    daylightcycle\n\u672C\u5C40\u76F4\u63A5\u80DC\u5229/win \u4FEE\u6539\u91D1\u94B1/money
    set \u6570\u91CF /money add \u6570\u91CF\n\u89E3\u9501\u5168\u90E8\u690D\u7269/unlock
    plant \u89E3\u9501\u5168\u90E8\u5173\u5361/unlock level"
  m_OffsetZ: 0
  m_CharacterSize: 0.12
  m_LineSpacing: 0.85
  m_Anchor: 4
  m_Alignment: 0
  m_TabSize: 2
  m_FontSize: 45
