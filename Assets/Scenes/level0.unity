--- !u!102 &2376
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1460}
  m_Text: "\u524D\u9662\uFF1A\u96E8\u5929\u4F1A\u51FA\u73B0\u79EF\u6C34\uFF0C\u53EF\u80FD\u4F1A\u6709\u5893\u7891\n\u540E\u9662\uFF1A\u96E8\u5929\u4F1A\u51FA\u73B0\u79EF\u6C34\uFF0C\u53EF\u80FD\u4F1A\u6709\u5893\u7891   
    \u5C4B\u9876\uFF1A\u96E8\u5929\u4E0D\u4F1A\u6709\u79EF\u6C34\uFF0C\u4E0D\u4F1A\u6709\u5893\u7891\n\u6CBC\u6CFD\n\u524D\u9662\uFF1A\u9633\u5149\u77F3\u7891\u673A\u5236\uFF1A\u51FB\u6740\u77F3\u7891\u4E0A\u5BF9\u5E94\u6570\u91CF\u50F5\u5C38\uFF0C\u5373\u53EF\u83B7\u5F97\u66F4\u591A\u9633\u5149\uFF0C\u77F3\u7891\u4E0B\u65B9\u67094\u6761\n\u5212\u75D5\uFF0C\u8868\u793A\u5269\u4F59\u65F6\u95F4\uFF0C\u65F6\u95F4\u4E0D\u8DB3\u540E\u51FB\u6740\u6570\u91CF\u4F1A\u91CD\u7F6E\uFF1B\u6811\u548C\u9633\u5149\u77F3\u7891\u4F1A\u8BA9\u50F5\u5C38\u6362\u884C\u3002\u571F\u5761\n\u4F1A\u963B\u6321\u5B50\u5F39\u3002\u6811\u836B\u4E0B\u79CD\u690D\u5411\u65E5\u8475\u7B49\u690D\u7269\u4F1A\u964D\u4F4E\u4EA7\u91CF\u3002\n\u540E\u9662\uFF1A\u6811\u548C\u5438\u5149\u5893\u7891\u4F1A\u8BA9\u50F5\u5C38\u6362\u884C\u3002\u623F\u5B50\u4E24\u8FB9\u6C34\u9762\u53EF\u79CD\u690D\u690D\u7269\u3002\u5438\u5149\u5893\u7891\u673A\u5236\uFF1A\n\u6BCF\u4E00\u6BB5\u65F6\u95F4\u5438\u6536\u573A\u4E0A\u9633\u5149\uFF0C\u53CC\u51FB\u53EF\u62A2\u56DE\uFF0C\u5438\u6536\u9633\u5149\u6570\u8D8A\u591A\u6B64\u5904\u751F\u6210\u50F5\u5C38\u6982\u7387\u8D8A\u5927\uFF0C\u751F\u6210\n\u4E00\u53EA\u50F5\u5C38\u51CF\u5C11\u4E00\u70B9\u9633\u5149\u503C\u3002\u4E00\u6BB5\u65F6\u95F4\u5438\u6536\u4E0D\u5230\u9633\u5149\u5C1D\u8BD5\u5438\u5F15\u5929\u5149\u3002"
  m_OffsetZ: 0
